  "clients": [
    {
      "clientId": "reports-frontend",
      "name": "Reports Frontend Application",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,  // Отключаем Resource Owner Password Credentials
      "serviceAccountsEnabled": false,
      
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3000"
      ],
      
      "webOrigins": [
        "http://localhost:3000",
        "*"
      ],
      
      "attributes": {
        "pkce.code.challenge.method": "S256",  // Включаем PKCE с SHA256
        "oauth2.device.authorization.grant.enabled": "false",
        "client.secret.creation.time": "0",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "use.refresh.tokens": "true",
        "refresh.token.max.reuse": "0",
        "exclude.session.state.from.auth.response": "false",
        "oidc.ciba.grant.enabled": "false",
        "post.logout.redirect.uris": "http://localhost:3000",
        "tls.client.certificate.bound.access.tokens": "false",
        "require.pushed.authorization.requests": "false",
        "acr.loa.map": "{}",
        "access.token.lifespan": "300",
        "client.offline.session.max.lifespan": "0"
      },
      
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "reports-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      
      "defaultClientScopes": [
        "web-origins",
        "role_list",
        "profile",
        "roles",
        "email"
      ],
      
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "reports-api",
      "name": "Reports API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      
      "secret": "oNwoLQdvJAvRcL89SydqCWCe5ry1jMgq",
      "clientAuthenticatorType": "client-secret",
      
      "attributes": {
        "client.secret.creation.time": "0",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "use.refresh.tokens": "true"
      },
      
      "defaultClientScopes": [
        "web-origins",
        "role_list",
        "profile",
        "roles",
        "email"
      ],
      
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  
  "clientScopes": [
    {
      "name": "role_list",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${roleScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "role list",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "user.attribute": "foo",
            "claim.name": "roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  
  "defaultRoles": [
    {
      "name": "default-roles-reports-realm",
      "description": "${role_default-roles}"
    }
  ]
}